# Endpoint that receives quote requests as JSON (POST).
# Leave empty to run the quote form in clearly-labelled DEMO mode (nothing is sent).
VITE_QUOTE_ENDPOINT=

# Video shown by the hero "Watch Video" button.
# Accepts a YouTube/Vimeo embed URL (e.g. https://www.youtube-nocookie.com/embed/VIDEO_ID)
# or a direct .mp4/.webm file URL. Leave empty to show a "video coming soon" notice.
VITE_HERO_VIDEO_URL=
